# ─── Server ───────────────────────────
PORT=3001
HOST=0.0.0.0

# ─── Supabase ─────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ─── OpenRouter (all LLM calls: chat, vision, audio, insights) ──
OPENROUTER_API_KEY=
# Cheap defaults (google/gemini-2.5-flash-lite: $0.10/$0.40 per 1M tokens, text+image+audio).
# Override per task; *_FALLBACKS are comma-separated and used automatically on provider errors.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_TEXT_MODEL=
# OPENROUTER_VISION_MODEL=
# OPENROUTER_AUDIO_MODEL=
# OPENROUTER_TEXT_FALLBACKS=mistralai/mistral-small-3.2-24b-instruct
# OPENROUTER_VISION_FALLBACKS=mistralai/mistral-small-3.2-24b-instruct
# OPENROUTER_AUDIO_FALLBACKS=mistralai/voxtral-small-24b-2507
# Max simultaneous in-flight LLM requests per instance (default 8)
# OPENROUTER_MAX_CONCURRENCY=8
# OPENROUTER_SITE_URL=https://farm-doctor.com
# OPENROUTER_APP_NAME=Farm Doctor
DEFAULT_COUNTRY=Cameroon

# ─── WhatsApp (Meta Cloud API) ────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ─── Telegram ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ─── OpenAI (TTS + Telegram fallback) ─
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TEXT_MODEL=gpt-4o-mini

# ─── YarnGPT (Pidgin TTS) ────────────
YARNGPT_API_KEY=
YARNGPT_API_URL=https://yarngpt.ai/api/v1/tts
YARNGPT_VOICE=Idera

# ─── Retell AI (Web Calls) ───────────
RETELL_API_KEY=
RETELL_AGENT_ID=

# ─── Fapshi Payments ─────────────────
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://live.fapshi.com
# Use https://sandbox.fapshi.com for testing

# ─── Feature Flags ───────────────────
ENABLE_VOICE_REPLIES=true
ENABLE_IMAGE_DIAGNOSIS=true
SUPABASE_STORAGE_BUCKET=crop-images

# ─── Fish Audio TTS (English + French voice replies; Pidgin stays on YarnGPT) ─
FISH_AUDIO_API_KEY=
# Voice model IDs from fish.audio (reference_id). FISH_AUDIO_VOICE_ID is the shared default.
FISH_AUDIO_VOICE_EN=
FISH_AUDIO_VOICE_FR=
# FISH_AUDIO_VOICE_ID=
# FISH_AUDIO_MODEL=s2.1-pro   # use s2.1-pro-free on the free tier

# ─── Google Cloud TTS (Telegram voice, last-resort fallback) ─
# Requires GOOGLE_APPLICATION_CREDENTIALS env or default credentials
# TTS_LANG_EN=en-GB
# TTS_LANG_FR=fr-FR
# TTS_LANG_PIDGIN=en-NG
# TTS_VOICE_EN=
# TTS_VOICE_FR=
# TTS_VOICE_PIDGIN=
