# ─── Server ───────────────────────────
PORT=3001
HOST=0.0.0.0

# ─── Supabase ─────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ─── Google AI (Vertex preferred — no API key needed) ──
# Set VERTEX_PROJECT_ID to use Vertex AI (recommended).
# Falls back to GEMINI_API_KEY if Vertex not configured.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=           # Only needed if NOT using Vertex
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
DEFAULT_COUNTRY=Cameroon

# ─── WhatsApp (Meta Cloud API) ────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ─── Telegram ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ─── OpenAI (TTS + Telegram fallback) ─
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TEXT_MODEL=gpt-4o-mini

# ─── YarnGPT (Pidgin TTS) ────────────
YARNGPT_API_KEY=
YARNGPT_API_URL=https://yarngpt.ai/api/v1/tts
YARNGPT_VOICE=Idera

# ─── Retell AI (Web Calls) ───────────
RETELL_API_KEY=
RETELL_AGENT_ID=

# ─── Fapshi Payments ─────────────────
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://live.fapshi.com
# Use https://sandbox.fapshi.com for testing

# ─── Feature Flags ───────────────────
ENABLE_VOICE_REPLIES=true
ENABLE_IMAGE_DIAGNOSIS=true
SUPABASE_STORAGE_BUCKET=crop-images

# ─── Google Cloud TTS (Telegram voice) ─
# Requires GOOGLE_APPLICATION_CREDENTIALS env or default credentials
# TTS_LANG_EN=en-GB
# TTS_LANG_FR=fr-FR
# TTS_LANG_PIDGIN=en-NG
# TTS_VOICE_EN=
# TTS_VOICE_FR=
# TTS_VOICE_PIDGIN=
